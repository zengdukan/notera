{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "tsBuildInfoFile": ".erb/dll/root.tsbuildinfo"
  },
  "include": [
    ".erb/**/*.ts",
    "assets/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["release/build", "release/app/dist", ".erb/dll"]
}
